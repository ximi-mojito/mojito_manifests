From 0f29363b19e79b97e23b0c35cd4cf71c74850fbc Mon Sep 17 00:00:00 2001
From: Quince <quinceroms@gmail.com>
Date: Sat, 4 Jul 2026 19:08:09 +0200
Subject: [PATCH] ActivityThread: Fall back to Sandboxed when NativeOnly class
 is missing

Chromium declares NativeOnlySandboxedProcessService* with
android:nativeService="true" and no Java class, for use under the native
app zygote prototype. With that prototype disabled, instantiating the
service throws ClassNotFoundException and the sandboxed renderer
crash-loops, hanging Chrome and WebView. Substitute the equivalent
SandboxedProcessService*, which the browser already handles as a
fallback, so the sandboxed process starts normally.

Signed-off-by: Quince <quinceroms@gmail.com>
---
 core/java/android/app/ActivityThread.java | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/frameworks/base/core/java/android/app/ActivityThread.java b/frameworks/base/core/java/android/app/ActivityThread.java
index b7d9f653023e9..3c17ee6cdf508 100644
--- a/frameworks/base/core/java/android/app/ActivityThread.java
+++ b/frameworks/base/core/java/android/app/ActivityThread.java
@@ -5612,8 +5612,25 @@ private void handleCreateService(CreateServiceData data) {
             } else {
                 cl = packageInfo.getClassLoader();
             }
-            service = packageInfo.getAppFactory()
-                    .instantiateService(cl, data.info.name, data.intent);
+            try {
+                service = packageInfo.getAppFactory()
+                        .instantiateService(cl, data.info.name, data.intent);
+            } catch (ClassNotFoundException e) {
+                // NativeOnlySandboxedProcessService* is declared android:nativeService="true"
+                // and has no Java class by design: it is meant to run as a native-only service
+                // under the native app zygote prototype. That prototype is disabled here, so the
+                // service falls through to normal Java instantiation and there is no class to
+                // create. Substitute the equivalent regular SandboxedProcessService*, which the
+                // browser is already prepared to fall back to, so the sandboxed renderer starts
+                // instead of crash-looping.
+                final String fallbackName = data.info.name.replace(
+                        ".NativeOnlySandboxedProcessService", ".SandboxedProcessService");
+                if (fallbackName.equals(data.info.name)) {
+                    throw e;
+                }
+                service = packageInfo.getAppFactory()
+                        .instantiateService(cl, fallbackName, data.intent);
+            }
             ContextImpl context = ContextImpl.getImpl(service
                     .createServiceBaseContext(this, packageInfo));
             if (data.info.splitName != null) {
